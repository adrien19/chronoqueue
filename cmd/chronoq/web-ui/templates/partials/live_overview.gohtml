{{ define "live_overview" }}
{{ if .PartialData }}<div class="mb-3 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-200" role="status">Some live queue data could not be loaded.</div>{{ end }}
<div>
  <div class="cq-panel-soft p-4">
    <div class="mb-2 text-sm font-medium text-white">Queue state snapshot</div>
    <div class="space-y-2">
      {{ range .QueueSummary }}<div class="flex items-center justify-between text-sm"><span class="text-zinc-300">{{ .Name }}</span><span class="text-zinc-400">{{ .Ready }} ready · {{ .Running }} running</span></div>{{ end }}
      {{ if not .QueueSummary }}<div class="text-sm text-zinc-500">No active queues</div>{{ end }}
    </div>
  </div>
</div>
{{ end }}
