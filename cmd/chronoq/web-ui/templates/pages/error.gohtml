{{ define "error_content" }}
<section class="space-y-5">
  <div>
    <div class="text-sm text-zinc-500">{{ .ErrorCode }}</div>
    <h2 class="text-2xl font-semibold text-white">{{ .ErrorTitle }}</h2>
  </div>

  <div class="cq-panel p-6">
    <div class="rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300">
      {{ .ErrorMessage }}
    </div>
  </div>
</section>
{{ end }}
