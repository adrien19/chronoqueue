{{ define "queue_new_content" }}
<section class="space-y-5">
  <div class="flex items-center gap-3">
    <a href="/queues" class="cq-btn !px-2">←</a>
    <h2 class="text-2xl font-semibold text-white">Create Queue</h2>
  </div>

  <div class="cq-panel p-6">
    <form method="POST" action="/api/queues/create" hx-post="/api/queues/create" hx-target="#form-result" class="space-y-6">

      <div>
        <label class="mb-2 block text-sm font-medium text-zinc-200">Queue Name <span class="text-red-400">*</span></label>
        <input class="cq-input w-full" type="text" name="name" required
          pattern="[a-zA-Z0-9][a-zA-Z0-9_\-]*"
          title="Must start with a letter or digit. Only letters, digits, hyphens, and underscores allowed."
          placeholder="my-queue">
        <p class="mt-1 text-xs text-zinc-500">Unique identifier. Letters, digits, hyphens, and underscores only — must start with a letter or digit.</p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="mb-2 block text-sm font-medium text-zinc-200">Queue Type <span class="text-red-400">*</span></label>
          <select class="cq-input w-full" name="type" id="queue_type">
            <option value="simple">Simple</option>
            <option value="exclusive">Exclusive</option>
          </select>
          <p class="mt-1 text-xs text-zinc-500">Simple: standard FIFO. Exclusive: single active consumer per exclusivity key.</p>
        </div>
        <div>
          <label class="mb-2 block text-sm font-medium text-zinc-200">Max Attempts</label>
          <input class="cq-input w-full" type="number" name="default_max_attempts" value="3" min="1" max="100">
          <p class="mt-1 text-xs text-zinc-500">Delivery attempts before a message is moved to the DLQ.</p>
        </div>
      </div>

      <div id="exclusivity_key_section" class="hidden">
        <label class="mb-2 block text-sm font-medium text-zinc-200">Exclusivity Key <span class="text-red-400">*</span></label>
        <input class="cq-input w-full" type="text" name="exclusivity_key" id="exclusivity_key" placeholder="worker-1">
        <p class="mt-1 text-xs text-zinc-500">Only one consumer holds a lease for the same exclusivity key at a time.</p>
      </div>

      <div>
        <label class="mb-2 block text-sm font-medium text-zinc-200">Lease Duration</label>
        <input class="cq-input w-48" type="text" name="lease_duration" value="30s" placeholder="30s">
        <p class="mt-1 text-xs text-zinc-500">How long a consumer holds a message lease (e.g. 30s, 5m, 1h).</p>
      </div>

      <details class="rounded-xl border border-line bg-zinc-950/40 p-5">
        <summary class="cursor-pointer text-sm font-medium text-zinc-300">Advanced delivery configuration</summary>
        <div class="mt-4 space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div><label class="mb-2 block text-sm text-zinc-200">Maximum payload size (bytes)</label><input class="cq-input w-full" type="number" min="1" name="max_payload_size" placeholder="System default"></div>
            <div><label class="mb-2 block text-sm text-zinc-200">Allowed content types</label><input class="cq-input w-full" name="allowed_content_types" placeholder="application/json, application/xml"><p class="mt-1 text-xs text-zinc-500">Comma-separated MIME types.</p></div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div><label class="mb-2 block text-sm text-zinc-200">Priority policy</label><select class="cq-input w-full" name="priority_policy"><option value="">Server default</option><option>STRICT</option><option>WEIGHTED</option><option>AGING</option><option>HYBRID</option></select></div>
            <div><label class="mb-2 block text-sm text-zinc-200">Priority weights (JSON)</label><input class="cq-input w-full font-mono" name="priority_weights" placeholder='{"4":70,"2":20,"0":10}'></div>
            <div><label class="mb-2 block text-sm text-zinc-200">Age boost threshold</label><input class="cq-input w-full" name="age_boost_threshold" placeholder="30m"></div>
            <div><label class="mb-2 block text-sm text-zinc-200">Age boost multiplier</label><input class="cq-input w-full" type="number" min="1" name="age_boost_multiplier" placeholder="2"></div>
          </div>
          <div class="grid grid-cols-4 gap-4">
            <div><label class="mb-2 block text-sm text-zinc-200">Base lease</label><input class="cq-input w-full" name="base_lease" placeholder="30s"></div>
            <div><label class="mb-2 block text-sm text-zinc-200">Maximum extension</label><input class="cq-input w-full" name="max_extension" placeholder="5m"></div>
            <div><label class="mb-2 block text-sm text-zinc-200">Heartbeat timeout</label><input class="cq-input w-full" name="heartbeat_timeout" placeholder="15s"></div>
            <div><label class="mb-2 block text-sm text-zinc-200">Extension step</label><input class="cq-input w-full" name="extend_step" placeholder="10s"></div>
          </div>
		  <div><label class="mb-2 block text-sm text-zinc-200">Maximum renewals</label><input class="cq-input w-48" type="number" min="0" name="max_renewals" placeholder="0 (unlimited)"></div>
          <div class="grid grid-cols-2 gap-4">
            <div><label class="mb-2 block text-sm text-zinc-200">Message retention</label><select class="cq-input w-full" name="retention_mode"><option value="">Server default</option><option value="DELETE_IMMEDIATELY">Delete immediately</option><option value="RETAIN_DURATION">Retain for duration</option><option value="RETAIN_FOREVER">Retain forever</option></select></div>
            <div><label class="mb-2 block text-sm text-zinc-200">Retention seconds</label><input class="cq-input w-full" type="number" min="1" name="retention_seconds" placeholder="2592000"></div>
          </div>
        </div>
      </details>

      <div class="space-y-4 rounded-xl border border-line bg-zinc-950/40 p-5">
        <p class="text-sm font-medium text-zinc-300">Dead Letter Queue</p>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="mb-2 block text-sm font-medium text-zinc-200">DLQ Name</label>
            <input class="cq-input w-full" type="text" name="dlq_name" placeholder="my-queue-dlq">
            <p class="mt-1 text-xs text-zinc-500">Leave blank to auto-generate as &lt;name&gt;-dlq when auto-create is enabled.</p>
          </div>
          <div class="flex items-center gap-3 pt-6">
            <input type="checkbox" class="rounded border-line bg-zinc-900 text-blue-500" name="auto_create_dlq" id="auto_create_dlq" value="true">
            <label for="auto_create_dlq" class="text-sm text-zinc-300">Auto-create DLQ</label>
          </div>
        </div>
      </div>

      <div class="space-y-4 rounded-xl border border-line bg-zinc-950/40 p-5">
        <p class="text-sm font-medium text-zinc-300">Schema Validation</p>
        <div>
          <label class="mb-2 block text-sm font-medium text-zinc-200">Schema ID</label>
          <input class="cq-input w-full" type="text" name="schema_id" list="schema-options" placeholder="order-schema">
          <datalist id="schema-options">
            {{ range .Schemas }}
            <option value="{{ .SchemaID }}">{{ if .Name }}{{ .Name }}{{ else }}{{ .SchemaID }}{{ end }} (latest v{{ .LatestVersion }})</option>
            {{ end }}
          </datalist>
          <p class="mt-1 text-xs text-zinc-500">Optional queue-level default schema. Leave blank to disable default validation.</p>
        </div>
        <div class="flex items-center gap-3">
          <input type="checkbox" class="rounded border-line bg-zinc-900 text-blue-500" name="schema_required" id="schema_required" value="true">
          <label for="schema_required" class="text-sm text-zinc-300">Require schema validation for all messages in this queue</label>
        </div>
      </div>

      <div id="form-result"></div>

      <div class="flex items-center gap-3 border-t border-line pt-4">
        <button class="cq-btn cq-btn-primary" type="submit">Create Queue</button>
        <a href="/queues" class="cq-btn">Cancel</a>
      </div>
    </form>
  </div>
</section>

{{ end }}
