{{ define "settings_cluster_new_content" }}
<section class="space-y-5">
  <div><div class="mb-2 text-sm text-zinc-500"><a href="/settings/clusters" class="hover:text-white">Clusters</a> / <span class="text-zinc-300">New</span></div><h2 class="text-4xl font-semibold text-white">Add cluster</h2></div>
  {{ if .Error }}<div class="cq-panel border-red-800 p-4 text-red-400">{{ .Error }}</div>{{ end }}
  <form method="POST" action="/api/clusters" class="cq-panel space-y-5 p-5">
    <div><label class="mb-2 block text-sm font-medium text-zinc-200">Cluster name</label><input class="cq-input w-full" name="name" value="{{ if .Form }}{{ .Form.Name }}{{ end }}" placeholder="Production" required></div>
    <div><label class="mb-2 block text-sm font-medium text-zinc-200">Description</label><input class="cq-input w-full" name="description" value="{{ if .Form }}{{ .Form.Description }}{{ end }}"></div>
    <div><label class="mb-2 block text-sm font-medium text-zinc-200">ChronoQueue endpoint</label><input class="cq-input w-full" name="brokerAddress" value="{{ if .Form }}{{ .Form.BrokerAddress }}{{ end }}" placeholder="localhost:50051" required></div>
    <div><label class="mb-2 block text-sm font-medium text-zinc-200">Transport</label><select class="cq-input w-full" name="transportMode"><option value="tls" {{ if or (not .Form) (eq .Form.TransportMode "tls") }}selected{{ end }}>TLS</option><option value="plaintext" {{ if and .Form (eq .Form.TransportMode "plaintext") }}selected{{ end }}>Plaintext</option></select><p class="mt-2 text-xs text-zinc-500">Use plaintext only on a trusted private network.</p></div>
    <div class="grid gap-5 md:grid-cols-2">
      <div><label class="mb-2 block text-sm font-medium text-zinc-200">TLS server name</label><input class="cq-input w-full" name="tlsServerName" value="{{ if .Form }}{{ .Form.TLSServerName }}{{ end }}" placeholder="queue.example.com"></div>
      <div><label class="mb-2 block text-sm font-medium text-zinc-200">CA certificate file</label><input class="cq-input w-full" name="caCertFile" value="{{ if .Form }}{{ .Form.CACertFile }}{{ end }}" placeholder="/run/secrets/chronoqueue-ca.pem"></div>
      <div><label class="mb-2 block text-sm font-medium text-zinc-200">Client certificate file</label><input class="cq-input w-full" name="clientCertFile" value="{{ if .Form }}{{ .Form.ClientCertFile }}{{ end }}"></div>
      <div><label class="mb-2 block text-sm font-medium text-zinc-200">Client key file</label><input class="cq-input w-full" name="clientKeyFile" value="{{ if .Form }}{{ .Form.ClientKeyFile }}{{ end }}"></div>
    </div>
    <label class="flex items-center gap-3"><input type="checkbox" name="skipTLSVerify" class="h-4 w-4 rounded" {{ if and .Form .Form.SkipTLSVerify }}checked{{ end }}><span class="text-sm text-zinc-200">Disable TLS certificate verification</span></label>
    <div><label class="mb-2 block text-sm font-medium text-zinc-200">API key environment variable</label><input class="cq-input w-full" name="apiKeyEnv" value="{{ if .Form }}{{ .Form.APIKeyEnv }}{{ end }}" placeholder="CHRONOQUEUE_API_KEY"><p class="mt-2 text-xs text-zinc-500">The secret remains in the process environment and is never written to the cluster file.</p></div>
    <div class="flex items-center gap-4 border-t border-line pt-5"><button type="submit" class="cq-btn cq-btn-primary">Add cluster</button><a href="/settings/clusters" class="cq-btn">Cancel</a></div>
  </form>
</section>
{{ end }}
