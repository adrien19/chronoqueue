{{ define "message_table" }}
<div class="overflow-x-auto">
<table class="cq-table">
  <thead><tr><th>ID</th><th>State</th><th>Priority</th><th>Attempts</th><th>Scheduled delivery</th><th></th></tr></thead>
  <tbody>
  {{ range .QueueMessages }}
  <tr>
    <td>
      <button class="font-mono text-sm font-medium text-white hover:text-blue-300"
        hx-get="/queues/{{ $.Queue.Name }}/messages?message_id={{ urlquery .Id }}"
        hx-target="#message-modal"
        hx-swap="innerHTML">{{ .ShortId }}</button>
    </td>
    <td><span class="{{ statusClass .State }}">{{ .State }}</span></td>
    <td>{{ .Priority }}</td>
    <td>{{ .AttemptCount }}</td>
    <td>{{ if .ScheduledAt }}{{ formatTime (derefTime .ScheduledAt) }}{{ else }}<span class="text-zinc-600">—</span>{{ end }}</td>
    <td>
	  {{ if $.Queue.IsDLQ }}
      <div class="flex items-center gap-2">
        <form method="POST" action="/api/queues/{{ $.Queue.Name }}/messages/{{ .Id }}/requeue" data-confirm="Requeue this message?">
		  {{ if gt (len $.Queue.SourceQueues) 1 }}
		  <select name="target_queue" required class="cq-input !py-1 text-xs">
			<option value="">Select target</option>
			{{ range $.Queue.SourceQueues }}<option value="{{ . }}">{{ . }}</option>{{ end }}
		  </select>
		  {{ end }}
          <button type="submit" class="cq-btn cq-btn-primary !px-2 !py-1 text-xs">Requeue</button>
        </form>
        <form method="POST" action="/api/queues/{{ $.Queue.Name }}/messages/{{ .Id }}/dlq-delete" data-confirm="Permanently delete this message?">
          <button type="submit" class="cq-btn !px-2 !py-1 text-xs text-red-400 hover:text-red-300">Delete</button>
        </form>
      </div>
	  {{ else if .Cancelable }}
	  <form method="POST" action="/api/queues/{{ $.Queue.Name }}/messages/{{ .Id }}/cancel" data-confirm="Cancel this message?">
		<button type="submit" class="cq-btn !px-2 !py-1 text-xs text-amber-300">Cancel</button>
	  </form>
	  {{ end }}
    </td>
  </tr>
  {{ end }}
  {{ if not .QueueMessages }}
  <tr><td colspan="6" class="py-8 text-center text-zinc-500">No messages found.</td></tr>
  {{ end }}
  </tbody>
</table>
</div>
<div id="message-modal"></div>
{{ end }}
