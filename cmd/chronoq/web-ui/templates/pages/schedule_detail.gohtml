{{ define "schedule_detail_content" }}
<section class="space-y-5">
  <div class="flex items-center gap-3"><a href="/schedules" class="cq-btn !px-2">←</a><div><div class="text-sm text-zinc-500">Schedule</div><h2 class="text-2xl font-semibold text-white">{{ .Schedule.ScheduleId }}</h2></div></div>
  <div class="cq-panel p-6">
    <div class="grid grid-cols-4 gap-3"><div class="cq-panel-soft p-4"><div class="cq-label">State</div><div class="mt-2">{{ .Schedule.Metadata.State }}</div></div><div class="cq-panel-soft p-4"><div class="cq-label">Queue</div><div class="mt-2">{{ .Schedule.Metadata.QueueName }}</div></div><div class="cq-panel-soft p-4"><div class="cq-label">Last run</div><div class="mt-2">{{ if .Schedule.Metadata.LastRun }}{{ formatTime .Schedule.Metadata.LastRun.AsTime }}{{ else }}Never{{ end }}</div></div><div class="cq-panel-soft p-4"><div class="cq-label">Next run</div><div class="mt-2">{{ if .Schedule.Metadata.NextRun }}{{ formatTime .Schedule.Metadata.NextRun.AsTime }}{{ else }}—{{ end }}</div></div></div>
    {{ if .Schedule.Metadata.StateMessage }}<div class="mt-4 rounded-lg border border-amber-500/30 bg-amber-500/10 p-3 text-sm text-amber-200">{{ .Schedule.Metadata.StateMessage }}</div>{{ end }}
    <dl class="mt-5 grid grid-cols-2 gap-3 text-sm"><div><dt class="text-zinc-500">Priority</dt><dd>{{ .Schedule.Metadata.Priority }}</dd></div><div><dt class="text-zinc-500">Maximum messages</dt><dd>{{ if .Schedule.Metadata.HasMaxMessages }}{{ .Schedule.Metadata.MaxMessages }}{{ else }}Unlimited{{ end }}</dd></div><div><dt class="text-zinc-500">Lease duration</dt><dd>{{ if .Schedule.Metadata.LeaseDuration }}{{ .Schedule.Metadata.LeaseDuration.AsDuration }}{{ else }}Queue default{{ end }}</dd></div><div><dt class="text-zinc-500">Schedule</dt><dd class="font-mono">{{ if .Schedule.Metadata.GetCronSchedule }}{{ .Schedule.Metadata.GetCronSchedule }}{{ else }}Calendar ({{ .Schedule.Metadata.GetCalendarSchedule.Timezone }}){{ end }}</dd></div></dl>
  </div>
  <div class="cq-panel overflow-hidden"><div class="border-b border-line px-5 py-4"><h3 class="text-lg font-semibold text-white">Execution history</h3><p class="text-sm text-zinc-500">Showing up to {{ .HistoryLimit }} generated messages.</p></div><table class="cq-table"><thead><tr><th>Message ID</th><th>State</th><th>Scheduled delivery</th></tr></thead><tbody>{{ if .History }}{{ range .History.Messages }}<tr><td class="font-mono">{{ .MessageId }}</td><td>{{ .Metadata.State }}</td><td>{{ if .Metadata.ScheduledTime }}{{ formatTime .Metadata.ScheduledTime.AsTime }}{{ else }}—{{ end }}</td></tr>{{ end }}{{ end }}{{ if or (not .History) (not .History.Messages) }}<tr><td colspan="3" class="py-8 text-center text-zinc-500">This schedule has not generated any messages.</td></tr>{{ end }}</tbody></table></div>
</section>
{{ end }}
